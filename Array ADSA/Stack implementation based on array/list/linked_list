#1. Convert Postfix to Infix
def postfix_to_infix(postfix):
    stack = []
    for char in postfix:
        if char.isalnum():
            stack.append(char)
        else:
            op2 = stack.pop()
            op1 = stack.pop()
            expr = f"({op1}{char}{op2})"
            stack.append(expr)
    return stack[-1]

# Example usage
postfix_expr = "ab+c*"
print("Infix:", postfix_to_infix(postfix_expr))

#2. Convert Postfix to Prefix
def postfix_to_prefix(postfix):
    stack = []
    for char in postfix:
        if char.isalnum():
            stack.append(char)
        else:
            op2 = stack.pop()
            op1 = stack.pop()
            expr = char + op1 + op2
            stack.append(expr)
    return stack[-1]

# Example usage
postfix_expr = "ab+c*"
print("Prefix:", postfix_to_prefix(postfix_expr))

#3. Convert Prefix to Postfix
def prefix_to_postfix(prefix):
    stack = []
    for char in reversed(prefix):
        if char.isalnum():
            stack.append(char)
        else:
            op1 = stack.pop()
            op2 = stack.pop()
            expr = op1 + op2 + char
            stack.append(expr)
    return stack[-1]

# Example usage
prefix_expr = "*+abc"
print("Postfix:", prefix_to_postfix(prefix_expr))

#4. Multiple Stacks Using a Single List
class MultiStack:
    def __init__(self, num_stacks, stack_size):
        self.num_stacks = num_stacks
        self.stack_size = stack_size
        self.stack = [None] * (num_stacks * stack_size)
        self.tops = [-1] * num_stacks

    def push(self, stack_num, value):
        if self.tops[stack_num] >= self.stack_size - 1:
            print(f"Stack {stack_num} is full.")
            return
        self.tops[stack_num] += 1
        index = stack_num * self.stack_size + self.tops[stack_num]
        self.stack[index] = value

    def pop(self, stack_num):
        if self.tops[stack_num] < 0:
            print(f"Stack {stack_num} is empty.")
            return None
        index = stack_num * self.stack_size + self.tops[stack_num]
        value = self.stack[index]
        self.stack[index] = None
        self.tops[stack_num] -= 1
        return value

# Example usage
ms = MultiStack(3, 5)
ms.push(0, 10)
ms.push(1, 20)
ms.push(2, 30)
print("Popped from stack 1:", ms.pop(1))
