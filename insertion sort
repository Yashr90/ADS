def insertion_sort(lst):
    s = len(lst)
    for i in range(1, s):
        temp = lst[i]
        j = i - 1
        while j >= 0 and temp < lst[j]:
            lst[j + 1] = lst[j]
            j -= 1
        lst[j + 1] = temp
n = int(input("Enter the number of elements: "))
lst = []
for i in range(n):
    num = int(input("Enter the elements: "))
    lst.append(num)
insertion_sort(lst)
print("Sorted list:", lst)
