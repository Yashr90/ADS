class StackNode:
  def __init__(self,Newdata,link):
    self.data=Newdata
    self.next=link
class Stack:
  def __init__(self):
    self.top=None
    return self.top is None
  def peek(self):
    return self.top.data
  def pop(self):
    node=self.top
    self.top=self.top.next
    return node.data
